# ---------------------------------------------------------------- TAK server
COT_URL=ssl://takserver:8089
# Old names REMOTE_SERVER_URL, REMOTE_SSL_USER_CERTIFICATE and
# REMOTE_SSL_USER_KEY still work
PYTAK_TLS_CLIENT_CERT=/data/cert.pem
PYTAK_TLS_CLIENT_KEY=/data/key.pem
PYTAK_TLS_DONT_VERIFY=1

# ---------------------------------------------------------------- GDACS
# Seconds between send rounds (min 30, old names UPDATE_INTERVAL and
# GDACS_PULL_INTERVAL)
#SEND_STATIC_INTERVAL=60
# Seconds between feed reads (min 600)
#FETCH_INTERVAL=600
# Marker lifetime in ATAK (s); always at least 3 send intervals
#STALE_SECONDS=180
# Only these alert levels (empty = all): Green,Orange,Red
#GDACS_ALERT_LEVELS=
#GDACS_URL=https://www.gdacs.org/xml/rss.xml
#TIMEZONE=Europe/Helsinki
#SOURCE_LINE=Source: GDACS (European Commission JRC, UN OCHA), CC BY 4.0
#DEBUG=0
